---
import "@fontsource-variable/inter";
import "../styles/global.css";
import logoUrl from "../../silverwright/logo.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="SilverWright creates engaging digital experiences." />
    <meta name="theme-color" content="#171819" />
    <title>SilverWright — Creating engaging digital experiences</title>
  </head>
  <body>
    <main class="canvas" id="top">
      <section class="main-stage" aria-labelledby="headline">
        <header class="topbar">
          <a class="top-brand" href="#top" aria-label="SilverWright home">
            <img src={logoUrl.src} alt="" width="20" height="22" />
            <span>SilverWright</span>
          </a>
          <span>Detroit / Worldwide</span>
        </header>

        <div class="hero-copy">
          <p class="pretitle">Designing the moments between intent and impact</p>
          <h1 id="headline">
            <span class="title-line title-creating">Creating</span>
            <span class="title-line title-engaging">engaging</span>
            <span class="title-line title-experiences">digital experiences</span>
          </h1>
        </div>

        <div class="abstract-field" aria-hidden="true">
          <span class="field-orbit orbit-one"></span>
          <span class="field-orbit orbit-two"></span>
          <span class="field-dot"></span>
        </div>

        <div class="bottom-row">
          <p>iOS apps &amp; digital products<br />with a point of view.</p>
        </div>
        <div class="cursor-pulse" aria-hidden="true"></div>
      </section>
    </main>

    <script>
      const stage = document.querySelector(".main-stage");
      const pulse = document.querySelector(".cursor-pulse");

      stage?.addEventListener("pointermove", (event) => {
        const bounds = stage.getBoundingClientRect();
        pulse?.style.setProperty("--x", `${event.clientX - bounds.left}px`);
        pulse?.style.setProperty("--y", `${event.clientY - bounds.top}px`);
        pulse?.classList.add("is-visible");
      });

      stage?.addEventListener("pointerleave", () => pulse?.classList.remove("is-visible"));
      stage?.addEventListener("pointerdown", () => {
        pulse?.classList.remove("is-pulsing");
        requestAnimationFrame(() => pulse?.classList.add("is-pulsing"));
      });
    </script>
  </body>
</html>
