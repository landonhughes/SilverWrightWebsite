---
import "@fontsource-variable/inter";
import "../styles/global.css";
import logoUrl from "../../silverwright/logo.svg";

const siteUrl = "https://silverwright.com";
const pageTitle = "SilverWright — Digital products with clarity";
const pageDescription = "SilverWright is an independent digital studio creating thoughtful iOS apps, digital products, and engaging experiences.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="SilverWright LLC" />
    <meta name="theme-color" content="#07111f" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href={logoUrl.src} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <meta property="og:image:alt" content="SilverWright digital studio" />
    <meta property="og:site_name" content="SilverWright" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}/og.png`} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "SilverWright LLC",
      url: siteUrl,
      logo: `${siteUrl}/og.png`,
      description: pageDescription,
      areaServed: "Worldwide",
      address: { "@type": "PostalAddress", addressLocality: "Detroit", addressRegion: "MI", addressCountry: "US" }
    })}></script>
  </head>
  <body>
    <main class="site-shell" id="top">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="#top" aria-label="SilverWright home">
          <img src={logoUrl.src} alt="" width="30" height="33" />
          <span>SilverWright</span>
        </a>
        <span class="location"><i></i>Detroit / Worldwide</span>
      </nav>

      <section class="hero" aria-labelledby="headline">
        <div class="hero-content">
          <p class="eyebrow"><span>01</span><span class="typing-label"><span id="typing-text" aria-live="polite"></span><span class="typing-cursor" aria-hidden="true"></span></span></p>
          <h1 id="headline">Creating<br /><em>engaging</em><br />digital experiences</h1>
        </div>

        <div class="hero-art" aria-label="SilverWright logo artwork">
          <div class="art-glow"></div>
          <div class="art-grid"></div>
          <div class="orbital orbital-large"></div>
          <div class="orbital orbital-small"></div>
          <div class="logo-orb"><img src={logoUrl.src} alt="" /></div>
        </div>
      </section>

      <section class="studio-strip" id="studio">
        <p><span class="section-number">02</span> Currently building</p>
        <div><strong>Something new for iOS</strong><span class="status"><i></i> Coming soon</span></div>
      </section>

      <footer class="footer" id="contact">
        <span>SilverWright LLC © <span id="current-year">2026</span></span>
      </footer>
    </main>

    <script>
      const year = document.querySelector("#current-year");
      if (year) year.textContent = String(new Date().getFullYear());

      const typingText = document.querySelector("#typing-text");
      if (typingText) {
        const words = ["Makers", "Crafters", "Designers", "Developers"];
        let wordIndex = 0;
        let characterIndex = 0;
        let deleting = false;

        const typeNext = () => {
          const word = words[wordIndex];
          characterIndex += deleting ? -1 : 1;
          typingText.textContent = word.slice(0, characterIndex);

          let delay = deleting ? 62 : 105;
          if (!deleting && characterIndex === word.length) {
            deleting = true;
            delay = 1400;
          } else if (deleting && characterIndex === 0) {
            deleting = false;
            wordIndex = (wordIndex + 1) % words.length;
            delay = 320;
          }

          window.setTimeout(typeNext, delay);
        };

        typeNext();
      }
    </script>
  </body>
</html>
